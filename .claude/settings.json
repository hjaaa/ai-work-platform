{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-protected-branch.sh\"",
            "timeout": 10,
            "statusMessage": "检查是否处于保护分支…"
          }
        ]
      }
    ]
  }
}
