# 生产环境：/api 前缀由部署侧（如 nginx）代理到网关
VITE_API_URL=/api

# OAuth2 客户端凭证与密码加密 key（公共客户端，非秘密；须与后端 Nacos security.encodeKey 一致）
VITE_CLIENT_ID=ai-work
VITE_CLIENT_SECRET=ai-work
VITE_ENC_KEY=aiwork2026aiwork
# 认证服务路径前缀：微服务形态经网关为 /auth；单体(boot)形态部署时改为 /admin
VITE_AUTH_PATH=/auth
# BaaS 服务路径前缀：微服务形态经网关为 /baas；单体(boot)形态部署时改为 /admin
VITE_BAAS_PATH=/baas

# 钉钉扫码登录应用 appKey(公开标识非秘密);联调/部署时替换为真实值
VITE_DINGTALK_APP_KEY=dingtalk-app-key-placeholder
VITE_FEISHU_APP_ID=feishu-app-id-placeholder
