<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="APP_NAME" value="ai-work-platform"/>

    <!-- 脱敏转换器（全环境生效） -->
    <conversionRule conversionWord="desensitize"
                    converterClass="com.aiworkplatform.web.config.logging.DesensitizeConverter"/>

    <!-- 公共日志格式 -->
    <property name="LOG_PATTERN_COLOR"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{traceId:-}] %cyan(%-40.40logger{39}) : %desensitize(%msg)%n"/>
    <property name="LOG_PATTERN_PLAIN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] %-40.40logger{39} : %desensitize(%msg)%n"/>

    <!-- 按 profile 加载对应的环境配置 -->
    <springProfile name="default,dev">
        <include resource="logback-dev.xml"/>
    </springProfile>

    <springProfile name="test">
        <include resource="logback-test.xml"/>
    </springProfile>

    <springProfile name="prod">
        <include resource="logback-prod.xml"/>
    </springProfile>

</configuration>
